        [
          "输入",
          "待处理原图、目标产品图、附加提示词、可选替换区域框选"
        ],
        [
          "输出",
          "包含目标产品的场景图"
        ],
        [
          "关键要求",
          "目标产品要出现在图中；尽量保持透视、比例、光影自然"
        ],
        [
          "需要确认",
          "目标产品图是否默认以白底图为主？替换结果是否接受“尽量自然”的初稿定位？"
