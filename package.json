{
  "name": "tickpic",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.12.1",
  "description": "Tickpic desktop creative workspace built with React and Electron.",
  "author": "Tickpic",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "config": {
    "electron_mirror": "https://npmmirror.com/mirrors/electron/"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:electron": "pnpm build:electron && ELECTRON_RENDERER_URL=http://127.0.0.1:3000 electron --no-sandbox dist-electron/electron/main.js",
    "desktop": "pnpm build && pnpm build:electron && electron --no-sandbox dist-electron/electron/main.js",
    "build": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json && esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/electron/preload.js --external:electron --sourcemap",
    "smoke:image-task": "node --env-file=.env --import tsx scripts/smoke-image-task.ts",
    "dist:win": "pnpm build && pnpm build:electron && electron-builder --win nsis",
    "dist:mac": "pnpm build && pnpm build:electron && electron-builder --mac dmg zip",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-electron release server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "openai": "^6.42.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^37.0.1",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.tickpic.desktop",
    "productName": "Tickpic",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/icon.png",
      "package.json"
    ],
    "extraMetadata": {
      "main": "dist-electron/electron/main.js"
    },
    "icon": "resources/icon.png",
    "win": {
      "icon": "resources/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "icon": "resources/icon.png",
      "category": "public.app-category.graphics-design",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "writeUpdateInfo": false
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@google/genai",
      "electron",
      "electron-winstaller",
      "esbuild",
      "protobufjs"
    ]
  }
}
